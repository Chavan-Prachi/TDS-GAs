# Use a cheap/free provider like Groq, OpenRouter, or local Ollama
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama3-70b-8192

# MUST be your actual public HTTPS deployment URL (no trailing slash issues)
BASE_URL=https://your-deployed-app.onrender.com/a2a